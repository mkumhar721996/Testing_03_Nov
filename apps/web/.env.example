# Base URL of the API the web app calls (e.g. GET /patients/me); unset means same-origin
VITE_API_BASE_URL=http://localhost:3000
# Local development only: role sent in x-user-role for the technician screens. The API trusts it only when
# started with ALLOW_INSECURE_ADMIN_HEADER=true. Leave unset anywhere else; real sign-in replaces this.
# VITE_DEV_USER_ROLE=admin
