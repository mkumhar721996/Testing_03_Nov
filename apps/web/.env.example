# Base URL of the Application API (empty means same origin)
VITE_API_BASE_URL=
# Stand-in for the signed-in user until the authentication story lands.
# Role: wfc_admin | fundraising_consultant | org_admin | org_staff
VITE_DEV_ROLE=
# Required for org_admin and org_staff: the organization they belong to
VITE_DEV_ORGANIZATION_ID=
