{
  "name": "comp-application-api",
  "version": "0.0.1",
  "private": true,
  "description": "Application API (NestJS)",
  "engines": {
    "node": "22"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "node --experimental-strip-types scripts/migrate.ts",
    "e2e": "playwright test",
    "devloop": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
