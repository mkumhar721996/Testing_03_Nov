# Required. PostgreSQL connection string.
DATABASE_URL=postgres://user:password@localhost:5432/app
# Fixed play-money starting balance (integer, 1 or more). Placeholder until the game economy is set.
GUEST_STARTING_BALANCE=1000
# Guest cookie lifetime in seconds. 2592000 (30 days) is provisional; retention is still undecided.
GUEST_SESSION_COOKIE_MAX_AGE_SECONDS=2592000
